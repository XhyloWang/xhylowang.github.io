---
import BaseLayout from "@layouts/BaseLayout.astro";
import BookingProcess from "@components/BookingProcess.astro";
import BookingPrompt from "@components/BookingPrompt.astro";
import EventFilmFeature from "@components/EventFilmFeature.astro";
import { featuredEventFilm, site } from "@lib/site";
---

<BaseLayout
  title={`Event Videography Singapore | ${site.name}`}
  description="Highlight films, interviews, and full speech recordings for conferences, company gatherings, and private celebrations in Singapore."
  active="videography"
  fullTitle
  image={featuredEventFilm.posterUrl}
>
  <section class="page-hero video-page-hero" aria-labelledby="video-page-title">
    <p class="eyebrow">Event video</p>
    <h1 id="video-page-title">Highlight films, interviews, and speeches</h1>
    <p>Video coverage for conferences, company gatherings, and private celebrations in Singapore.</p>
  </section>

  <section class="video-work" aria-label="Featured film">
    <div class="video-work-inner">
      <EventFilmFeature {...featuredEventFilm} id="soul-mates-film-title" loading="lazy" />

      <div class="video-film-context">
        <h2>My role</h2>
        <p>I filmed the performance and edited the final cut, following the music and the interplay between the players rather than a fixed shot list. The film stays close to the performance, letting the playing carry the edit from the first note to the last.</p>
      </div>
    </div>
  </section>

  <section class="video-scope" aria-labelledby="video-scope-title">
    <div class="video-scope-inner">
      <h2 id="video-scope-title">What would you like to capture?</h2>
      <div class="video-service-grid">
        <article>
          <h3>Highlight films</h3>
          <p>Key moments, people, and atmosphere brought together in one edited film.</p>
        </article>
        <article>
          <h3>Interviews</h3>
          <p>Conversations with speakers, guests, or your team.</p>
        </article>
        <article>
          <h3>Full speech recordings</h3>
          <p>A complete recording of a presentation or speech for later viewing.</p>
        </article>
      </div>

      <div class="video-planning-note">
        <p>We’ll agree the video length, filming format, turnaround, and revisions before booking. If you need horizontal and vertical versions, or photography alongside video, include that in your enquiry. Event video is delivered within 3–5 business days. Delivery within 1 business day or on the same day may be available by arrangement. Let’s discuss what you need before booking.</p>
      </div>
    </div>
  </section>

  <BookingProcess />
  <BookingPrompt variant="video" />
</BaseLayout>

<style>
  .video-page-hero.page-hero {
    padding-bottom: clamp(58px, 8vw, 88px);
    text-align: center;
  }

  .video-page-hero.page-hero h1,
  .video-page-hero.page-hero > .eyebrow,
  .video-page-hero.page-hero > p:not(.eyebrow) {
    margin-inline: auto;
  }

  .video-page-hero.page-hero h1 {
    max-width: 1040px;
  }

  .video-page-hero.page-hero > p:not(.eyebrow) {
    max-width: 720px;
  }

  .video-work {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(66px, 8vw, 104px) max(var(--gutter), calc((100vw - var(--max)) / 2));
  }

  .video-work::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--charcoal);
    content: "";
  }

  .video-work-inner {
    width: min(100%, var(--max));
    margin: 0 auto;
  }

  .video-work-inner :global(.event-film-feature) {
    max-width: 1180px;
    margin: 0 auto;
  }

  .video-work-inner :global(.event-film-intro h2) {
    letter-spacing: -0.025em;
  }

  .video-film-context {
    width: min(100%, 720px);
    margin: clamp(32px, 4vw, 46px) auto 0;
    border-top: 1px solid rgba(255, 250, 241, 0.2);
    padding-top: 22px;
    color: var(--paper-bright);
    text-align: center;
  }

  .video-film-context h2 {
    text-align: left;
    margin: 0 0 12px;
    color: var(--paper-bright);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .video-film-context p {
    margin: 0;
    color: rgba(255, 250, 241, 0.78);
    line-height: 1.55;
    text-align: left;
  }

  .video-scope {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2)) clamp(72px, 9vw, 112px);
  }

  .video-scope::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--paper);
    content: "";
  }

  .video-scope-inner {
    width: min(100%, var(--max));
    margin: 0 auto;
  }

  .video-scope h2 {
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .video-service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 36px);
  }

  .video-service-grid article {
    border-top: 1px solid var(--hairline);
    padding-top: 18px;
    text-align: left;
  }

  .video-service-grid h3 {
    margin: 0 0 12px;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    letter-spacing: -0.015em;
    line-height: 1.16;
  }

  .video-service-grid p,
  .video-planning-note p {
    margin: 0;
    line-height: 1.55;
  }

  .video-planning-note {
    max-width: 760px;
    margin: clamp(36px, 5vw, 58px) auto 0;
    padding-top: 0;
    text-align: left;
  }

  @media (max-width: 700px) {
    .video-service-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .video-film-context {
      margin-top: 30px;
      padding-top: 18px;
    }

    .video-scope h2 {
      margin-bottom: 28px;
    }
  }
</style>
